---
import About from "../../components/About.astro";
import Certifications from "../../components/Certifications.astro";
import Contact from "../../components/Contact.astro";
import Formation from "../../components/Formation.astro";
import Hero from "../../components/Hero.astro";
import Projects from "../../components/Projects.astro";
import Skills from "../../components/Skills.astro";
import Timeline from "../../components/Timeline.astro";
import Layout from "../../layouts/Layout.astro";
import { getAbout, getCertifications, getExperiences, getProjects, getSettings, getSkills } from "../../lib/directus";
import { localizeContent } from "../../i18n/content";
import t from "../../i18n/en.json";

const [about, settings, projects, experiences, skills, certifications] = await Promise.all([
  getAbout(),
  getSettings(),
  getProjects(),
  getExperiences(),
  getSkills(),
  getCertifications()
]);

const localized = localizeContent("en", { about, settings, projects, experiences, skills, certifications });
---

<Layout about={localized.about} settings={localized.settings} t={t} lang="en">
  <Hero about={localized.about} t={t} />
  <About about={localized.about} t={t} />
  <Timeline experiences={localized.experiences} t={t} />
  <Formation experiences={localized.experiences} t={t} />
  <Projects projects={localized.projects} t={t} />
  <Skills skills={localized.skills} t={t} />
  <Certifications certifications={localized.certifications} t={t} />
  <Contact about={localized.about} t={t} />
</Layout>
