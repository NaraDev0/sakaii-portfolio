---
import { getAssetURL, type Project } from "../lib/directus";

const { project, t } = Astro.props as { project: Project; t: any };
const coverUrl = getAssetURL(project.cover);
const statusClass = `status status-${project.status}`;
---

<article class="card project-card" data-project-card data-category={project.category}>
  <div class="project-cover">
    {coverUrl && <img src={coverUrl} alt={`Couverture du projet ${project.title}`} loading="lazy" />}
    {project.featured && <span class="featured-badge">{t.projects.featured}</span>}
  </div>

  <div class="project-body">
    <div class="project-top">
      <span class="project-meta">{t.categories[project.category]}</span>
      <span class={statusClass}>
        <span class="status-dot" aria-hidden="true"></span>
        {t.status[project.status]}
      </span>
    </div>

    <h3>{project.title}</h3>
    <p class="project-excerpt">{project.excerpt}</p>

    <div class="tag-list">
      {project.tags?.map((tag) => <span class="tag">{tag}</span>)}
    </div>
  </div>
</article>
