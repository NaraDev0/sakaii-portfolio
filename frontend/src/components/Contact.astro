---
import { getAssetURL, type About } from "../lib/directus";

const { about, t } = Astro.props as { about: About; t: any };
const handle = about.instagram?.replace(/^@/, "") || "mikael_bch";
const instagramUrl = `https://www.instagram.com/${handle}/`;
const cvUrl = getAssetURL(about.cv);
---

<section class="section contact-section" id="contact" data-reveal>
  <div class="container">
    <div class="contact-band">
      <h2>{t.contact.title}</h2>
      <p>{t.contact.subtitle}</p>
      <div class="contact-actions">
        <a class="btn btn-primary" href={instagramUrl} target="_blank" rel="noreferrer">
          {t.contact.instagram} ({about.instagram})
        </a>
        <a class="btn btn-ghost" href={cvUrl || `mailto:${about.email}`}>{cvUrl ? t.contact.cv : t.contact.email}</a>
      </div>
    </div>
  </div>
</section>
