---
import About from "../components/About.astro";
import Certifications from "../components/Certifications.astro";
import Contact from "../components/Contact.astro";
import Formation from "../components/Formation.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Timeline from "../components/Timeline.astro";
import Layout from "../layouts/Layout.astro";
import { getAbout, getCertifications, getExperiences, getProjects, getSettings, getSkills } from "../lib/directus";
import t from "../i18n/fr.json";

const [about, settings, projects, experiences, skills, certifications] = await Promise.all([
  getAbout(),
  getSettings(),
  getProjects(),
  getExperiences(),
  getSkills(),
  getCertifications()
]);
---

<Layout about={about} settings={settings} t={t} lang="fr">
  <Hero about={about} t={t} />
  <About about={about} t={t} />
  <Timeline experiences={experiences} t={t} />
  <Formation experiences={experiences} t={t} />
  <Projects projects={projects} t={t} />
  <Skills skills={skills} t={t} />
  <Certifications certifications={certifications} t={t} />
  <Contact about={about} t={t} />
</Layout>
